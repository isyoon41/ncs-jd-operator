# 공공데이터포털에서 발급받은 한국산업인력공단 NCS API 서비스 키
NCS_API_SERVICE_KEY=

# Supabase 프로젝트 URL / publishable key (ncs-jd-generator 프로젝트, Supabase 대시보드 > Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase service_role 키 (Project Settings > API > service_role, "secret" 표시된 키).
# RLS를 완전히 우회하는 최고 권한 키입니다 — 절대 커밋하지 말고, 클라이언트 코드에서 import하지 마세요.
# 관리자 콘솔의 회원 목록 조회·정지·삭제 기능(src/lib/supabase/admin.ts)에만 서버에서 사용됩니다.
SUPABASE_SERVICE_ROLE_KEY=

# Google AI Studio Gemini API key (서버에서만 사용, NEXT_PUBLIC_ 접두사 금지)
GEMINI_API_KEY=

# Sentry 에러 모니터링 (Sentry 프로젝트 생성 후 DSN 발급, sentry.io > Settings > Projects > Client Keys)
# 비워두면 Sentry가 초기화되지 않고 조용히 비활성화됩니다.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
# 빌드 시 소스맵 업로드용 (선택, sentry.io > Settings > Auth Tokens). 없으면 소스맵 업로드만 건너뜁니다.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
